{
  "manifest_version": 3,
  "name": "IG Circle Scraper",
  "version": "1.0",
  "description": "Scrapes followers and following lists from an Instagram profile",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://www.instagram.com/*",
    "*://instagram.com/*"
  ],
  "icons": {
    "16": "icons/icon.jpg",
    "48": "icons/icon.jpg",
    "128": "icons/icon.jpg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Circle Scraper",
    "default_icon": {
      "16": "icons/icon.jpg",
      "48": "icons/icon.jpg",
      "128": "icons/icon.jpg"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
